#!/usr/bin/env python3
"""
Read a markdown document in your browser, and edit it there when you want to.

    mdeus <document.md>           serve the document to a window of its own
    mdeus --edit <document.md>    the same, with vim beside it from the start
    mdeus --tab <document.md>     serve it to a tab of your default browser
    mdeus --print <document.md>   write one self contained HTML file, print its
                                  path, and open nothing
    mdeus --diff <older.md> <newer.md>
                                  show what changed from the older document
                                  to the newer on one page

A reading opens as the page and nothing else. The window it opens in carries
the page and no more: no address bar, no tabs, no bookmarks, and it fills the
screen. It comes from Chrome, Chromium, Brave, Vivaldi or Edge, whichever of
them is on the machine, and where none of them is the reading opens in a tab as
though --tab had been asked for.

The Edit toggle at the top of the page brings vim in beside it. The page and vim
are then one window, the page on the left and gvim on the right, with a seam
between them you can drag. Press it again, or quit vim, and vim goes and the
page is handed back to the desktop, still open on the same document and still
where you had scrolled it to. --edit is that toggle pressed for you before you
see the page.

A reading is served from this machine and nowhere else, redrawn whenever the
file changes. While it is only the page, it ends on ctrl-c or with the page,
which holds it open by a connection nothing but the page closing drops. That is
what ends a reading started from the file manager, where there is no terminal to
interrupt, and it asks nothing of the page while it is open, so a window left in
the background keeps its reading. A reading ended by ctrl-c takes its page with
it, since the window is the browser's and would otherwise be left standing with
nothing behind it. A page in a tab is left alone, being one of a browser's own
windows and carrying more than the reading. While vim is up, the
reading is held by vim: ctrl-c, the window's close button and the page being
closed all ask vim to quit, and vim refuses while anything in it is unwritten,
so nothing is taken away from under unsaved work.

Several readings run at once, each on its own port, each under a name of its
own, and one to a document. mdeus run on a document a reading already has
opens nothing: it brings the window of that reading to the front, and says so.
The document is read and not written, with one thing excepted: a task list
box pressed in the page is that box's own line of the source rewritten, one
character of it and nothing else. While vim is up even that goes to vim rather
than to the file, so a document somebody is editing is never written round the
back of them.

Only a document named .md or .markdown is read. Anything else is refused in
one line, whichever way it was asked for.

--diff shows the older document compared with the newer as one page,
inserted words on green and deleted ones on red, under the newer one's name.
Both have to be markdown, or a pull request as below. git difftool -t mdeus
shows a change to a document the same way, and git runs

    mdeus --diff <older> <newer> <document>

once for each document the change touches, and waits for the page to close
before it runs the next. The third name is the document as the repository has
it, and the page goes under it: its title, its look and the images beside it.
git hands over an empty file for a side the document is missing from, so where
a third name is given it alone says whether the document is markdown.

A comparison is read only: there is no Edit toggle and no box can be pressed.
It claims nothing, so a document already open in a reading of its own can be
compared beside it, and it is drawn again whenever either version is written.

Either name may be the link to a pull request on GitHub instead,
https://github.com/<org>/<repo>/pull/<number>, and its description is compared
as though it were a document on the disk. A link copied from a tab or a
comment of the pull request names it as well. gh fetches it once, as the page
opens, so an edit to the description on GitHub is not drawn until the command
is run again. Where the pull request is the newer side, the page goes under
its link.
"""

import argparse
import contextlib
import os
import re
import signal
import subprocess
import sys
import tempfile
import threading
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'share' / 'mdeus'))

import vimlink
import window
from browser import browser_path
from claim import claim, holder
from export import write_export
from server import NAME, reading_name, serve, start

MARKDOWN = ('.markdown', '.md')
PULL = re.compile(r'https://github\.com/([^/]+)/([^/]+)/pull/(\d+)(?=[/#?]|$)')
WAKE = 1


def compare(names, document, tab):
    """Serve a comparison, fetching any pull request in it to a file first.

    The descriptions are written into a directory that lasts as long as the
    reading does, and that is made only where there is a pull request to put
    in it. The page goes under the link where the pull request is the newer
    side and no document was named for it, without anything the link carries
    after the number.
    """
    fetching = (
        tempfile.TemporaryDirectory(prefix=f'{NAME}-')
        if any(PULL.match(name) for name in names)
        else contextlib.nullcontext()
    )
    with fetching as directory:
        versions = []
        for name in names:
            version = (
                fetch_pull(name, directory) if PULL.match(name)
                else Path(name)
            )
            if version is None:
                return 1
            versions.append(version)
        pull = PULL.match(names[1])
        title = pull.group(0) if document is None and pull else None
        read(document or versions[1], False, tab, versions, title)
    return 0


def fetch_pull(link, directory):
    """Write a pull request's description into a directory, and return it.

    gh does the fetching, so a private repository is read as whoever gh is
    logged in as. Where it fails it has said why, and nothing is returned.
    Where it is not on the machine at all, that is said in one line.
    The file is named after the repository and the number, so the two sides
    of a comparison between two pull requests never land on the same file.
    Anything after the number, such as a tab or a comment of the pull
    request, is left off, since the description is the same whichever of
    them the link was copied from.
    """
    pull = PULL.match(link)
    org, repo, number = pull.groups()
    try:
        fetched = subprocess.run(
            ['gh', 'pr', 'view', pull.group(0), '--json', 'body', '--jq',
             '.body'],
            stdout=subprocess.PIPE, text=True,
        )
    except FileNotFoundError:
        print(f'{NAME}: comparing with a pull request needs gh',
              file=sys.stderr)
        return None
    if fetched.returncode:
        return None
    path = Path(directory) / f'{org}-{repo}-pull-{number}.md'
    path.write_text(fetched.stdout, encoding='utf-8')
    return path


def interrupt(reading, ending):
    """Return the ctrl-c handler for one reading.

    Ctrl-c means the reading is to end, in both of its states. Where vim is up
    it is asked to quit first, and it refuses while anything in it is unwritten,
    so the reading ends when vim does and not before. Where vim is not up there
    is nothing to ask and the wait is simply woken.
    """

    def handler(number, frame):
        """End the reading, asking vim first where vim is up."""
        ending.set()
        if reading.editing:
            vimlink.quit_vim(reading.servername)
        reading.asked.set()

    return handler


def main(argv=None):
    """Run the command line entry point."""
    args = parse_args(argv)
    document = args.document
    for name in [args.document] if args.document else args.diff:
        if not PULL.match(str(name)) and Path(name).suffix not in MARKDOWN:
            print(f'{NAME}: not a markdown document: {name}', file=sys.stderr)
            return 1
    if args.diff:
        return compare(args.diff, document, args.tab)
    if not document.is_file():
        print(f'{NAME}: no such file: {document}', file=sys.stderr)
        return 1
    if not os.access(document, os.R_OK):
        print(f'{NAME}: cannot read: {document}', file=sys.stderr)
        return 1
    if args.print:
        try:
            print(write_export(document))
        except UnicodeDecodeError:
            print(f'{NAME}: not text: {document}', file=sys.stderr)
            return 1
        return 0
    if args.edit and not on_a_desktop():
        print(f'{NAME}: --edit needs a desktop session', file=sys.stderr)
        return 1
    held = claim(document)
    if held is None:
        window.bring_forward(holder(document))
        print(f'{NAME}: {document.name} is already open')
        return 0
    read(document, args.edit, args.tab)
    return 0


def on_a_desktop():
    """Say whether there is a desktop to open vim into."""
    return bool(os.environ.get('DISPLAY'))


def parse_args(argv):
    """Return the parsed command line."""
    parser = argparse.ArgumentParser(
        prog=NAME,
        description='Read a markdown document in your browser, and edit it there.',
    )
    parser.add_argument(
        'document',
        help='markdown file to read, or the name a comparison goes under',
        nargs='?',
        type=Path,
    )
    opening = parser.add_mutually_exclusive_group()
    opening.add_argument(
        '--diff',
        help='show what changed from OLDER to NEWER on one page, either of '
        'which may be a GitHub pull request link',
        metavar=('OLDER', 'NEWER'),
        nargs=2,
    )
    opening.add_argument(
        '--edit',
        action='store_true',
        help='open with vim beside the page, rather than waiting for the Edit toggle',
    )
    opening.add_argument(
        '--print',
        action='store_true',
        help='write one self contained HTML file and print its path, opening nothing',
    )
    parser.add_argument(
        '--tab',
        action='store_true',
        help='open in a tab of your default browser rather than a window of its own',
    )
    args = parser.parse_args(argv)
    if args.document is None and args.diff is None:
        parser.error('the following arguments are required: document')
    return args


def read(document, edit, tab, versions=None, title=None):
    """Serve one reading and hold it up until it ends.

    The server runs on a thread of its own for the whole of a reading, because
    the main thread is wanted for two things it cannot give up: the X event loop
    that holds an editing session together, and the signal handler above, which
    the interpreter will only run on the main thread.

    What that main thread does is wait. A reading that is only the page waits
    for the page to ask for vim, and a reading with vim waits inside the
    session. Ending a session either ends the reading or drops it back to
    waiting, and which of the two is the session's to say.

    Some of that waiting is spent warming vim. gvim takes half a second to put a
    window together, and a reading that leaves that until the Edit toggle is
    pressed spends the whole of it with somebody watching. So it is spent
    earlier instead, once the page says it has drawn the document and the
    machine is free again, and vim waits out of sight until it is wanted. It is
    warmed again after each session, since a reading may edit as many times as
    the box is ticked and only the first vim was warmed for free.

    A reading opened on two versions is never edited, so no vim is warmed for
    it either. The title is what the page goes under where that is not the
    document's path.
    """
    servername = reading_name(os.getpid())
    app_window = bool(browser_path()) and not tab
    bound, reading, url = start(
        document, servername, editable=on_a_desktop() and versions is None,
        versions=versions, title=title,
    )
    print(f'reading {document.name}')
    print(f'  {url}/{servername}')
    print('  ctrl-c to stop, or close the page', flush=True)
    threading.Thread(target=serve, args=(bound, reading), daemon=True).start()

    ending = threading.Event()
    signal.signal(signal.SIGINT, interrupt(reading, ending))
    if edit:
        if window.edit(reading, url, ending, opening=True, app_window=app_window):
            return
    else:
        window.open_page(url, servername, app_window)
        if app_window:
            window.maximise_page(servername)
            window.name_page(servername)

    waiting = None
    warmed = False
    try:
        while not ending.is_set():
            reading.asked.clear()
            if reading.over.is_set():
                break
            if reading.wanted:
                session = waiting
                waiting = None
                warmed = False
                if window.edit(reading, url, ending, app_window=app_window,
                               waiting=session):
                    return
                continue
            if (not warmed and app_window and reading.editable
                    and reading.drawn.is_set()):
                warmed = True
                waiting = window.warm(reading, url)
                continue
            reading.asked.wait(WAKE)
        if ending.is_set() and app_window:
            window.stop_page(reading.servername)
    finally:
        window.cool(reading, waiting)


if __name__ == '__main__':
    sys.exit(main())

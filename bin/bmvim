#!/usr/bin/env bash
#
# Read a markdown document in your browser with vim beside it, in one window.
# The browser takes the left of that window and a terminal running vim takes the
# right. Clicking a block sends vim to the line it came from, centred and lit for
# a moment, moving the vim cursor marks the block it is in, and writing the file
# redraws the page.
#
#   bmvim <document.md>
#
# The reading opens a terminal of its own for vim, so the shell this was run from
# stays yours and waits. It needs a desktop session, so use bmv where there is
# none, and only one reading runs at a time.
#
# The page opens in the browser you already have running, which is why it opens
# as quickly as it does, and the reading holds it by that one window: it is taken
# into the reading's window and asked to close when the reading ends, and the
# rest of the browser is left alone throughout.
#
# The reading ends when vim quits. Closing the browser pane, pressing the
# window's close button and interrupting here all ask vim to quit instead, and
# vim refuses while anything in it is unwritten. Killing the terminal outright
# ends it the same way quitting vim does. However it ends, the server stops and
# the page's window goes.

set -euo pipefail

# One name for the one reading. vim keeps servernames upper cased and so does
# the check that only one reading is up.
SERVERNAME=BMVIM

# The modules this drives sit beside the script inside the package, so they are
# found whether the package is stowed or run from a checkout of it.
share="$(dirname "$(readlink -f "$0")")/../share/mdview"
link="$share/vimlink.py"

if [ $# -ne 1 ]
then
  echo "usage: bmvim <document.md>" >&2
  exit 1
fi

if [ ! -f "$1" ]
then
  echo "bmvim: no such file: $1" >&2
  exit 1
fi

if [ ! -r "$1" ]
then
  echo "bmvim: cannot read: $1" >&2
  exit 1
fi

file="$(readlink -f "$1")"

if [ -z "${DISPLAY:-}" ]
then
  echo "bmvim: needs a desktop session, so use bmv where there is none" >&2
  exit 1
fi

# One reading at a time. vim answers to the name or it does not, and if it does
# it is asked what it has open, so the refusal says which document is being read.
if held="$(python3 "$link" holder "$SERVERNAME")"
then
  echo "bmvim: already reading ${held:-another document}" >&2
  exit 1
fi

dir="$(mktemp -d)"
server=

# However the reading ends, it ends here. Nothing in here is allowed to fail
# loudly or to stop what follows it: by the time it runs, some of what it is
# putting away has often gone already.
cleanup(){
  trap - EXIT HUP INT TERM
  [ -n "$server" ] && kill "$server" 2>/dev/null || true
  rm -rf "$dir"
}
trap cleanup EXIT HUP INT TERM

# The server takes the port it is given or any free one, since a reading opened
# elsewhere may already hold the first, so it says where it landed and this
# waits to be told before anything is opened on it. A pipe rather than a file,
# so the wait is the read itself and ends the moment the line arrives, or the
# moment the server gives up and closes its end.
mkfifo "$dir/url"
python3 "$share/bmvim_serve.py" "$file" "$SERVERNAME" > "$dir/url" &
server=$!
url=
read -r url < "$dir/url" || true

if [ -z "$url" ]
then
  echo "bmvim: the reading did not start" >&2
  exit 1
fi

echo "bmvim: reading $(basename "$file"), at $url"
echo "       ctrl-c here asks vim to quit, as the reading's close button does"

# The window the reading is drawn in, and everything inside it. This holds the
# shell until the reading ends.
python3 "$share/bmvim_window.py" \
  "$url" "$SERVERNAME" "$share/cursor.vim" "$file"

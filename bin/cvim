#!/usr/bin/env bash
#
# Read a markdown document in your browser with vim beside it. The browser takes
# the left of the screen and a terminal running vim takes the right. Clicking a
# block sends vim to the line it came from, centred and lit for a moment, moving
# the vim cursor marks the block it is in, and writing the file redraws the page.
#
#   cvim <document.md>
#
# Run from a terminal, vim runs in that terminal. Run from the file manager, a
# terminal is opened for it. It needs a desktop session, so use bmv where there
# is none, and only one reading runs at a time.
#
# The reading ends when vim quits, when the browser window is closed, or when
# the terminal is killed. However it ends, the server stops, the browser window
# goes, the terminal is given its window list entry back and the browser profile
# the reading made is removed.

set -euo pipefail

# One name for the one reading. vim keeps servernames upper cased and so does
# the check that only one reading is up.
SERVERNAME=CVIM

# The modules this drives sit beside the script inside the package, so they are
# found whether the package is stowed or run from a checkout of it.
share="$(dirname "$(readlink -f "$0")")/../share/mdview"
link="$share/vimlink.py"

if [ $# -ne 1 ]
then
  echo "usage: cvim <document.md>" >&2
  exit 1
fi

if [ ! -f "$1" ]
then
  echo "cvim: no such file: $1" >&2
  exit 1
fi

if [ ! -r "$1" ]
then
  echo "cvim: cannot read: $1" >&2
  exit 1
fi

file="$(readlink -f "$1")"

# Before the terminal below, which is another thing there is no desktop session
# to open.
if [ -z "${DISPLAY:-}" ]
then
  echo "cvim: needs a desktop session, so use bmv where there is none" >&2
  exit 1
fi

# Started from the file manager there is no terminal for vim to run in, so one
# is opened and the reading starts again inside it. mate-terminal is named
# rather than left to the desktop, whose own search finds gnome-terminal first
# on this machine.
if [ ! -t 0 ]
then
  exec mate-terminal -- "$0" "$file"
fi

# One reading at a time. vim answers to the name or it does not, and if it does
# it is asked what it has open, so the refusal says which document is being read.
if held="$(python3 "$link" holder "$SERVERNAME")"
then
  echo "cvim: already reading ${held:-another document}" >&2
  exit 1
fi

browser=
dir="$(mktemp -d)"
placer=
server=
watcher=
winid=

# However the reading ends, it ends here: vim quitting returns to the line that
# started it, the browser window closing asks vim to quit, and the terminal
# being killed outright never reaches either, which is what the trap is for.
# Nothing in here is allowed to fail loudly or to stop what follows it: by the
# time it runs, some of what it is putting away has often gone already.
cleanup(){
  trap - EXIT HUP INT TERM
  for child in "$watcher" "$placer" "$browser" "$server"
  do
    [ -n "$child" ] && kill "$child" 2>/dev/null || true
  done
  python3 "$link" give-back "$winid" 2>/dev/null || true
  rm -rf "$dir"
}
trap cleanup EXIT HUP INT TERM

# The server takes the port it is given or any free one, since a reading opened
# elsewhere may already hold the first, so it says where it landed and this
# waits to be told before anything is opened on it.
python3 "$share/server.py" "$file" "$SERVERNAME" > "$dir/url" &
server=$!
url=
for _ in $(seq 100)
do
  url="$(cat "$dir/url")"
  if [ -n "$url" ]
  then
    break
  fi
  sleep 0.05
done

if [ -z "$url" ]
then
  echo "cvim: the reading did not start" >&2
  exit 1
fi

# The terminal is the window the desktop has in front, which the browser takes
# the moment it appears, so it is settled here and named by number from now on.
# It is written on and put in its place before either the browser or vim opens,
# so that vim starts in a terminal that has already finished changing size.
winid="$(python3 "$link" window)"
python3 "$link" borrow "$winid" 2>/dev/null || true
python3 "$link" place-terminal "$winid"

chrome=
for candidate in google-chrome chromium chromium-browser
do
  if command -v "$candidate" > /dev/null
  then
    chrome="$candidate"
    break
  fi
done

if [ -n "$chrome" ]
then
  # --app gives a window with nothing in it but the page, and a profile of its
  # own makes that window a process of its own, which is what lets the reading
  # own it and close it. The profile is thrown away when the reading ends, so
  # none of this touches your usual browsing. A profile that has never been
  # used greets you on the way in, and the greeting would arrive over the
  # document, so it is turned off.
  # The flags that place the window are unquoted because there are two of them,
  # or none at all where nothing on the machine can say how big the screen is.
  # shellcheck disable=SC2086
  "$chrome" --app="$url" $(python3 "$link" browser-flags) --no-first-run \
    --user-data-dir="$dir/profile" > /dev/null 2>&1 &
  browser=$!

  # A browser window is drawn a little larger than the size it was given, so it
  # is put right once it is up, against where the terminal actually settled.
  # In the background, since vim should not be kept waiting for a browser.
  python3 "$link" place-browser "$winid" "$browser" &
  placer=$!

  # The window being closed ends the reading. vim is asked to quit and refuses
  # while anything in it is unwritten, and the page stops saying it is open,
  # which is what stops the server.
  (
    while kill -0 "$browser" 2>/dev/null
    do
      sleep 0.5
    done
    python3 "$link" quit "$SERVERNAME"
  ) &
  watcher=$!
else
  echo "cvim: no chrome or chromium here, so the page opens in a tab of your"
  echo "      usual browser, which is neither placed nor closed for you"
  xdg-open "$url" > /dev/null 2>&1 &
fi

# What vim does for as long as the reading is up. Kept as a file of its own
# rather than typed at vim a piece at a time, since it reads better here than it
# would through a keyhole.
cat > "$dir/cursor.vim" <<'EOF'
" Say where the cursor is, for the page to mark the block holding it.
"
" A timer holds this to one report every 150ms. A document scrolled through
" with a key held down moves the cursor far oftener than a page can draw it,
" and the timer reads the line when it comes round rather than when it was set,
" so what is reported is always where the cursor ended up.
"
" The report is started and left to itself. Waiting on it would put the whole
" of vim behind a server that may have stopped listening, and every line
" stepped through would stutter.
let s:pending = 0

function! s:MdviewReport(timer) abort
  let s:pending = 0
  call job_start(['python3', $MDVIEW_LINK, 'cursor', $MDVIEW_URL, string(line('.'))])
endfunction

function! s:MdviewMoved() abort
  if s:pending
    return
  endif
  let s:pending = 1
  call timer_start(150, function('s:MdviewReport'))
endfunction

augroup mdview
  autocmd!
  autocmd CursorMoved,CursorMovedI * call s:MdviewMoved()
augroup END

" Where the cursor starts, so the page marks a block from the first moment
" rather than waiting to be moved.
call s:MdviewReport(0)

" Where a clicked block lands. The page knows the source lines every block was
" built from and sends both ends of them, so the whole block is lit rather than
" the line it starts at. A pale ground for the eye to land on without hunting,
" and gone again once the eye has had it: long enough to be seen, short enough
" not to be read against. Set as a default, so that naming CvimJump in .vimrc
" overrides it.
let s:linger = 1500
highlight default CvimJump ctermfg=black ctermbg=153 guifg=black guibg=#BDDFFF

" The window and the mark are told to the moment that puts it out, rather than
" left for it to find, since by the time it comes round the window it was lit in
" may not be the one in hand. A mark already gone is no matter. The names are
" plain ones, since a name held to this file cannot be called from the page and
" cannot be handed to a timer.
function! CvimFadeMark(window, match, timer) abort
  silent! call matchdelete(a:match, a:window)
endfunction

function! CvimJumpTo(first, last) abort
  " Only the block last clicked is ever lit. The mark from the click before
  " goes, and so does the moment still counting down for it, which would
  " otherwise come round and put out the light this click has just lit.
  if exists('w:cvim_timer')
    silent! call timer_stop(w:cvim_timer)
    unlet w:cvim_timer
  endif
  if exists('w:cvim_match')
    silent! call matchdelete(w:cvim_match)
    unlet w:cvim_match
  endif
  call cursor(a:first, 1)
  normal! zz
  let w:cvim_match = matchadd(
    \ 'CvimJump', '\%>' . (a:first - 1) . 'l\%<' . (a:last + 1) . 'l.\+')
  if exists('*timer_start')
    let w:cvim_timer =
      \ timer_start(s:linger, function('CvimFadeMark', [win_getid(), w:cvim_match]))
  endif
endfunction
EOF

# notitle after the vimrc rather than before it, since a vimrc that turns the
# title on would otherwise win. Left on, vim writes the name of the file on the
# terminal every time the document changes, and the window list entry the
# reading has just borrowed would be written over within the second.
MDVIEW_LINK="$link" MDVIEW_URL="$url" \
  vim --servername "$SERVERNAME" -c 'set notitle' -S "$dir/cursor.vim" -- "$file"
